<UserControl x:Class="DynamicIsland.Views.ToastView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DynamicIsland.Controls"
             Width="320" Height="48">
    <!-- [icon | image]  [title + subtitle | level bar]  [trailing text + battery] -->
    <Grid Margin="9,0,16,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Width="30" Height="30" VerticalAlignment="Center">
            <Ellipse x:Name="IconBackground"/>
            <TextBlock x:Name="IconGlyph" FontFamily="{StaticResource IconFont}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border x:Name="ImageHost" CornerRadius="8" Visibility="Collapsed"
                    RenderOptions.BitmapScalingMode="HighQuality">
                <Border.Background>
                    <ImageBrush x:Name="ImageFill" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
        </Grid>

        <StackPanel x:Name="TextStack" Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryText}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SubtitleText" FontSize="11.5"
                       Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Grid x:Name="LevelHost" Grid.Column="1" Height="6" Margin="12,0" VerticalAlignment="Center" Visibility="Collapsed">
            <Border Background="{StaticResource TrackFill}" CornerRadius="3"/>
            <Border Background="{StaticResource PrimaryText}" CornerRadius="3" RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="LevelScale" ScaleX="0" ScaleY="1"/>
                </Border.RenderTransform>
            </Border>
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="TrailingText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{StaticResource PrimaryText}" Typography.NumeralAlignment="Tabular"/>
            <controls:BatteryGlyph x:Name="BatteryIcon" Width="27" Height="13" Margin="7,0,0,0"
                                   VerticalAlignment="Center" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>
