<UserControl x:Class="DynamicIsland.Views.TuckedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DynamicIsland.Controls"
             Height="16" IsHitTestVisible="False">
    <!-- Tucked mini bar: [music wave] [timer] [app icons] [+N]. Clicks always pass through to the tabs below. -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <controls:AudioBars x:Name="Bars" Width="13" Height="9" VerticalAlignment="Center"
                            BarBrush="{Binding Media.AccentBrush}"/>
        <TextBlock x:Name="TimerText" VerticalAlignment="Center"
                   FontFamily="{StaticResource DisplayFont}" FontSize="10" FontWeight="SemiBold"
                   Foreground="{StaticResource TimerOrange}" Typography.NumeralAlignment="Tabular"
                   Text="{Binding Timers.CompactText}"/>
        <Image x:Name="Icon1" Width="11" Height="11" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Image x:Name="Icon2" Width="11" Height="11" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Image x:Name="Icon3" Width="11" Height="11" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock x:Name="MoreText" VerticalAlignment="Center"
                   FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryText}"/>
    </StackPanel>
</UserControl>
