<UserControl x:Class="DynamicIsland.Views.ExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DynamicIsland.Controls"
             xmlns:views="clr-namespace:DynamicIsland.Views"
             Width="400">
    <UserControl.Resources>
        <views:InvertedBoolToVisibility x:Key="InvertedBoolToVis"/>

        <!-- Home widget: a rounded card that lifts a little on hover and presses in -->
        <Style x:Key="WidgetCard" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#17FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border CornerRadius="18" Background="{TemplateBinding Background}"/>
                            <Border x:Name="Hover" CornerRadius="18" Background="#10FFFFFF" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource HoverIn}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource HoverOut}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource PressDownSoft}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource PressUp}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Controls card tile: grey when off, the accent colour when on (Tag carries the state) -->
        <Style x:Key="ControlTile" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border CornerRadius="16" Background="#1FFFFFFF"/>
                            <Border x:Name="Selected" CornerRadius="16" Background="{StaticResource Accent}" Opacity="0"/>
                            <Border x:Name="Hover" CornerRadius="16" Background="#14FFFFFF" Opacity="0"/>
                            <ContentPresenter Margin="10,9"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource HoverIn}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource HoverOut}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource SelectIn}"/>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource SelectOut}"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource PressDown}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource PressUp}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundToggle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Ellipse Fill="#29FFFFFF"/>
                            <Ellipse x:Name="Selected" Fill="{StaticResource Accent}" Opacity="0"/>
                            <Ellipse x:Name="Hover" Fill="#18FFFFFF" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource HoverIn}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource HoverOut}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource SelectIn}"/>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource SelectOut}"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource PressDown}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource PressUp}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Hover" CornerRadius="10" Background="#1AFFFFFF" Opacity="0"/>
                            <ContentPresenter Margin="12,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource HoverIn}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource HoverOut}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource PressDownSoft}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource PressUp}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FeedHeaderButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Hover" CornerRadius="16" Background="#10FFFFFF" Opacity="0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource HoverIn}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource HoverOut}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource PressDownSoft}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource PressUp}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One app's group in the notifications card: newest line when folded, recent messages when open -->
        <DataTemplate x:Key="FeedGroup">
            <Border Margin="0,0,0,6" CornerRadius="16" Background="#12FFFFFF">
                <StackPanel>
                    <Button Style="{StaticResource FeedHeaderButton}" Height="60" Click="FeedGroup_Click">
                        <Grid Margin="12,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="28" Height="28" Stretch="Uniform" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding AppName, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold"
                                         Foreground="{StaticResource PrimaryText}"/>
                                    <Run Text="  "/>
                                    <Run Text="{Binding TimeText, Mode=OneWay}" FontSize="10.5" Foreground="{StaticResource TertiaryText}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding LatestLine}" FontSize="11.5" Margin="0,2,0,0"
                                           Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Border Grid.Column="2" MinWidth="20" Height="18" CornerRadius="9" Padding="6,0" Margin="0,0,6,0"
                                    Background="{StaticResource Accent}" VerticalAlignment="Center"
                                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Count}" FontSize="10.5" FontWeight="SemiBold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="3" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="2,0,4,0"
                                       Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE70D;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Text" Value="&#xE70E;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="4" Style="{StaticResource IconButton}" Width="26" Height="26"
                                    Click="FeedGroupDismiss_Click" ToolTip="Clear">
                                <Path Data="{StaticResource CloseGeometry}" Stroke="{StaticResource SecondaryText}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="8" Height="8"/>
                            </Button>
                        </Grid>
                    </Button>
                    <ItemsControl ItemsSource="{Binding TopItems}" Margin="6,0,6,6" Focusable="False"
                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PickButton}" Height="44" Click="FeedItem_Click" ToolTip="Open">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryText}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Body}" FontSize="11" Margin="0,1,0,0"
                                                       Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding TimeText, Mode=OneWay}" FontSize="10.5" Margin="8,0,4,0"
                                                   Foreground="{StaticResource TertiaryText}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="24" Height="24"
                                                Click="FeedItemDismiss_Click" ToolTip="Dismiss">
                                            <Path Data="{StaticResource CloseGeometry}" Stroke="{StaticResource SecondaryText}"
                                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Stretch="Uniform" Width="7" Height="7"/>
                                        </Button>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <!-- The dashboard: a switcher row on top, one card below it. Card heights are fixed on
         purpose: ExpandedView.Configure computes the island height from them, so the spring
         knows its target before layout runs. -->
    <StackPanel Margin="18,12,18,16">

        <!-- ======================================================== Switcher row -->
        <ItemsControl x:Name="Switcher" Height="32" HorizontalAlignment="Center" Focusable="False"
                      ItemsSource="{Binding Dashboard.Tabs}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource TabButton}" Click="Tab_Click" ToolTip="{Binding Label}">
                        <Grid Width="24" Height="24">
                            <!-- App icon style: coloured tile, soft gloss, white symbol -->
                            <Border CornerRadius="7" Background="{Binding Tint}"
                                    Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Border CornerRadius="7" Background="{StaticResource TabGloss}"/>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="12.5"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVis}}"/>
                            <Border CornerRadius="7" Visibility="{Binding ShowArt, Converter={StaticResource BoolToVis}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Border MinWidth="14" Height="14" CornerRadius="7" Padding="3,0" Background="#FFFF3B30"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-9,0"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding BadgeText}" FontSize="8.5" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Border>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ======================================================== Cards (exactly one visible) -->
        <Grid x:Name="CardHost" Margin="0,10,0,0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="CardSlide"/>
            </Grid.RenderTransform>

            <!-- ==================== Home: clock, battery, paused music tile, quick timers -->
            <!-- ==================== Home, widget style: a tinted clock card, two small widgets
                 beside it (battery, music, notifications or Wi-Fi, whichever apply), and a dock of
                 your quick apps (4 to 6, chosen in Settings › Personalization › Home). -->
            <Grid x:Name="HomeCard" Height="178">
                <Grid.RowDefinitions>
                    <RowDefinition Height="116"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="52"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Clock: opens the Windows Clock app -->
                    <Button Style="{StaticResource WidgetCard}" Click="ClockWidget_Click" ToolTip="Open Clock">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF213152" Offset="0"/>
                                <GradientStop Color="#FF151B2B" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Grid Margin="14,11,12,12">
                            <TextBlock x:Name="DayText" Text="Today" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="#FF8FB6FF" VerticalAlignment="Top"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Margin="0,0,0,-2" Foreground="{StaticResource PrimaryText}"
                                           FontFamily="{StaticResource DisplayFont}" Typography.NumeralAlignment="Tabular">
                                    <Run x:Name="ClockRun" Text="00:00" FontSize="38" FontWeight="SemiBold"/><Run x:Name="AmPmRun" Text="" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SecondaryText}"/>
                                </TextBlock>
                                <TextBlock x:Name="DateText" Text="" FontSize="12" Foreground="{StaticResource SecondaryText}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Grid x:Name="WidgetStack" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Battery ring -->
                        <Button x:Name="BatteryWidget" Style="{StaticResource WidgetCard}" Click="BatteryWidget_Click"
                                ToolTip="Power and battery settings">
                            <Grid Margin="10,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="32" Height="32" VerticalAlignment="Center">
                                    <Ellipse Stroke="#26FFFFFF" StrokeThickness="3"/>
                                    <Path x:Name="BatteryArc" Stroke="#FF30D158" StrokeThickness="3"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock x:Name="BatteryPercentText" Text="" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Battery" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/>
                                    <TextBlock x:Name="BatteryStateText" Text="" FontSize="11" Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource SecondaryText}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Music: the card opens the player, the round button plays or pauses in place -->
                        <Button x:Name="MusicWidget" Style="{StaticResource WidgetCard}" Click="MusicWidget_Click"
                                ToolTip="Show player" Visibility="Collapsed">
                            <Grid Margin="8,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="34" Height="34" VerticalAlignment="Center">
                                    <Border CornerRadius="9" Background="{StaticResource ArtworkPlaceholder}">
                                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   Foreground="{StaticResource TertiaryText}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border CornerRadius="9" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Media.Artwork}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <Image Source="{Binding Media.AppIcon}" Width="14" Height="14" Margin="0,0,-4,-4"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Media.Title}" FontSize="12.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource PrimaryText}"/>
                                    <TextBlock x:Name="MusicStateText" Text="" FontSize="11" Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource SecondaryText}"/>
                                </StackPanel>
                                <Button x:Name="HomePlayButton" Grid.Column="2" Style="{StaticResource CircleButton}" Width="26" Height="26"
                                        Background="#F2FFFFFF" VerticalAlignment="Center" Click="HomePlayPause_Click" ToolTip="Play">
                                    <Path x:Name="HomePlayGlyph" Data="{StaticResource PlayGeometry}" Fill="Black" Stretch="Uniform"
                                          Width="9" Height="10" Margin="1,0,0,0"/>
                                </Button>
                            </Grid>
                        </Button>

                        <!-- Notifications waiting -->
                        <Button x:Name="NotifWidget" Style="{StaticResource WidgetCard}" Click="NotifWidget_Click"
                                ToolTip="Show notifications" Visibility="Collapsed">
                            <Grid Margin="10,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="10" Background="#33FF9F0A" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7E7;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="#FFFF9F0A"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="NotifTitleText" Text="" FontSize="12.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource PrimaryText}"/>
                                    <TextBlock Text="Notifications" FontSize="11" Margin="0,1,0,0" Foreground="{StaticResource SecondaryText}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Wi-Fi: only when neither a battery nor music has a place here -->
                        <Button x:Name="WifiWidget" Style="{StaticResource WidgetCard}" Click="WifiWidget_Click"
                                ToolTip="Quick controls" Visibility="Collapsed">
                            <Grid Margin="10,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="10" Background="#330A84FF" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="#FF0A84FF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Controls.WifiCaption}" FontSize="12.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource PrimaryText}"/>
                                    <TextBlock x:Name="WifiStateText" Text="" FontSize="11" Margin="0,1,0,0" Foreground="{StaticResource SecondaryText}"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>

                <!-- Dock: icons only, the name shows on hover -->
                <Border Grid.Row="2" CornerRadius="18" Background="#12FFFFFF" Padding="6,0">
                    <ItemsControl VerticalAlignment="Center" Focusable="False" ItemsSource="{Binding QuickApps.Apps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TileButton}" Click="QuickApp_Click" ToolTip="{Binding Name}">
                                    <Border Width="40" Height="40" CornerRadius="12" Margin="0,3"
                                            Background="{Binding Tile}" BorderBrush="#1CFFFFFF" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                       Foreground="{StaticResource TertiaryText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding HasIcon, Converter={StaticResource InvertedBoolToVis}}"/>
                                            <Image Source="{Binding Icon}" Width="26" Height="26" Stretch="Uniform"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>

            <!-- ==================== Quick controls, Control Center style: switches that act directly -->
            <StackPanel x:Name="ControlsCard" Visibility="Collapsed">
            <Grid Height="156">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Connectivity: round toggles; right click Wi-Fi or Bluetooth for their Windows page -->
                <Border CornerRadius="20" Background="#17FFFFFF" Padding="6,8">
                <UniformGrid Rows="2" Columns="2">
                    <StackPanel HorizontalAlignment="Center">
                        <Button Style="{StaticResource RoundToggle}" Tag="{Binding Controls.WifiOn}" Click="WifiTile_Click" MouseRightButtonUp="WifiTile_RightClick"
                                HorizontalAlignment="Center" ToolTip="Wi-Fi (right click for networks)">
                            <TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="White"/>
                        </Button>
                        <TextBlock Text="{Binding Controls.WifiCaption}" FontSize="10.5" Margin="0,5,0,0" MaxWidth="72" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource SecondaryText}"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <Button Style="{StaticResource RoundToggle}" Tag="{Binding Controls.BluetoothOn}" Click="BluetoothTile_Click" MouseRightButtonUp="BluetoothTile_RightClick"
                                HorizontalAlignment="Center" ToolTip="Bluetooth (right click for devices)">
                            <TextBlock Text="&#xE702;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="White"/>
                        </Button>
                        <TextBlock Text="Bluetooth" FontSize="10.5" Margin="0,5,0,0" MaxWidth="72" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource SecondaryText}"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <Button Style="{StaticResource RoundToggle}" Tag="{Binding Controls.DoNotDisturb}" Click="DndTile_Click"
                                HorizontalAlignment="Center" ToolTip="Island do not disturb: messages wait as bubbles">
                            <TextBlock Text="&#xE708;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="White"/>
                        </Button>
                        <TextBlock Text="Do not disturb" FontSize="10.5" Margin="0,5,0,0" MaxWidth="72" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource SecondaryText}"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <Button Style="{StaticResource RoundToggle}" Tag="{Binding Controls.DarkMode}" Click="DarkTile_Click"
                                HorizontalAlignment="Center" ToolTip="Dark mode: opens Windows colour settings">
                            <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="White"/>
                        </Button>
                        <TextBlock Text="Dark mode" FontSize="10.5" Margin="0,5,0,0" MaxWidth="72" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </UniformGrid>
                </Border>

                <!-- Mini player: the same music as the Music tab; the art opens it -->
                <Border Grid.Column="2" CornerRadius="20" Background="#17FFFFFF" Padding="12">
                    <Grid>
                        <Grid Visibility="{Binding Media.HasMedia, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Button Style="{StaticResource TileButton}" HorizontalAlignment="Stretch" Click="MiniPlayer_Click" ToolTip="Open the player">
                                <Grid HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource ArtworkPlaceholder}">
                                        <Border CornerRadius="10">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Media.Artwork}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="96">
                                        <TextBlock Text="{Binding Media.Title}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryText}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Media.SourceLabel}" FontSize="10.5" Margin="0,1,0,0"
                                                   Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Width="36" Height="34" Click="Previous_Click"
                                        IsEnabled="{Binding Media.CanSkipPrevious}">
                                    <Path Data="{StaticResource PreviousGeometry}" Fill="White" Stretch="Uniform" Width="18" Height="12"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="40" Height="34" Margin="8,0" Click="PlayPause_Click">
                                    <Path Fill="White" Stretch="Uniform" Width="15" Height="17">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{StaticResource PlayGeometry}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Media.IsPlaying}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource PauseGeometry}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="36" Height="34" Click="Next_Click"
                                        IsEnabled="{Binding Media.CanSkipNext}">
                                    <Path Data="{StaticResource NextGeometry}" Fill="White" Stretch="Uniform" Width="18" Height="12"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Media.HasMedia, Converter={StaticResource InvertedBoolToVis}}">
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TertiaryText}"/>
                            <TextBlock Text="Nothing playing" FontSize="11.5" Margin="0,8,0,0" HorizontalAlignment="Center"
                                       Foreground="{StaticResource SecondaryText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Height="40" Margin="0,10,0,0">
                <controls:PillSlider x:Name="ControlsVolume" Value="{Binding Audio.Volume, Mode=OneWay}" IsInteractive="{Binding Audio.HasDevice, Mode=OneWay}"/>
                <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="#FF1C1C1E"
                           Margin="13,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock Text="{Binding Audio.Volume, StringFormat={}{0:P0}}" FontSize="11" Foreground="#FF8E8E93" Margin="0,0,15,0"
                           HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                           Typography.NumeralAlignment="Tabular"/>
            </Grid>
            <Grid Height="40" Margin="0,8,0,0" Visibility="{Binding Controls.HasBrightness, Converter={StaticResource BoolToVis}}">
                <controls:PillSlider x:Name="ControlsBrightness" Value="{Binding Controls.Brightness, Mode=OneWay}" IsInteractive="{Binding Controls.HasBrightness, Mode=OneWay}"/>
                <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="#FF1C1C1E"
                           Margin="13,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock Text="{Binding Controls.Brightness, StringFormat={}{0:P0}}" FontSize="11" Foreground="#FF8E8E93" Margin="0,0,15,0"
                           HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                           Typography.NumeralAlignment="Tabular"/>
            </Grid>

            <Grid Height="46" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource RowButton}" Click="ToggleOutputs_Click">
                    <Grid Margin="12,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7F5;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="White" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="Output" FontSize="10" Foreground="{StaticResource SecondaryText}"/>
                            <TextBlock Text="{Binding Controls.OutputName}" FontSize="12" Foreground="{StaticResource PrimaryText}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                   Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource RowButton}" Click="ToggleInputs_Click">
                    <Grid Margin="12,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="White" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="Input" FontSize="10" Foreground="{StaticResource SecondaryText}"/>
                            <TextBlock Text="{Binding Controls.InputStatus}" FontSize="12" Foreground="{StaticResource PrimaryText}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                   Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Grid>
            <ItemsControl ItemsSource="{Binding Controls.Outputs}" Margin="0,4,0,0" Focusable="False"
                          Visibility="{Binding Controls.OutputsOpen, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource PickButton}" Click="Endpoint_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                           Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" Margin="6,0,0,0"
                                           Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Controls.Inputs}" Margin="0,4,0,0" Focusable="False"
                          Visibility="{Binding Controls.InputsOpen, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource PickButton}" Click="Endpoint_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                           Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" Margin="6,0,0,0"
                                           Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Shortcuts: Windows pages it can't switch itself, plus mute toggles and the island's Settings -->
            <UniformGrid Rows="1" Columns="7" Height="36" Margin="0,10,0,0">
                <Button Style="{StaticResource CircleButton}" Width="36" Height="36" Tag="airplane" Click="ControlLink_Click" ToolTip="Airplane mode">
                    <TextBlock Text="&#xE709;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#FFD8D8DE"/>
                </Button>
                <Button Style="{StaticResource CircleButton}" Width="36" Height="36" Tag="batterysaver" Click="ControlLink_Click" ToolTip="Battery saver">
                    <TextBlock Text="&#xE83F;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#FFD8D8DE"/>
                </Button>
                <Button Style="{StaticResource CircleButton}" Width="36" Height="36" Tag="hotspot" Click="ControlLink_Click" ToolTip="Mobile hotspot">
                    <TextBlock Text="&#xE88A;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#FFD8D8DE"/>
                </Button>
                <Button Style="{StaticResource CircleButton}" Width="36" Height="36" Tag="nightlight" Click="ControlLink_Click" ToolTip="Night light">
                    <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#FFD8D8DE"/>
                </Button>
                <Button Style="{StaticResource RoundToggle}" Width="36" Height="36" Tag="{Binding Audio.IsMuted}"
                        Click="ControlsMute_Click" ToolTip="Mute sound">
                    <TextBlock Text="&#xE74F;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="White"/>
                </Button>
                <Button Style="{StaticResource RoundToggle}" Width="36" Height="36" Tag="{Binding Controls.MicMuted}"
                        Click="MicMute_Click" ToolTip="Mute the microphone">
                    <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="White"/>
                </Button>
                <Button Style="{StaticResource CircleButton}" Width="36" Height="36" Click="ControlsSettings_Click" ToolTip="Island settings">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#FFD8D8DE"/>
                </Button>
            </UniformGrid>

            <TextBlock Text="{Binding Controls.Message}" Height="30" Padding="2,8,0,0" FontSize="11.5" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource TimerOrange}"
                       Visibility="{Binding Controls.HasMessage, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <!-- ==================== Music: player, seek, volume, shrink to bubble -->
            <Grid x:Name="MusicCard" Visibility="Collapsed">
            <StackPanel>
            <Grid x:Name="PlayerHost" Height="158">
            <Grid x:Name="MainPlayer" Height="158">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="MainPlayerSlide"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Click the art to jump to the player -->
                    <Border x:Name="ArtworkButton" CornerRadius="14" Background="{StaticResource ArtworkPlaceholder}"
                            RenderOptions.BitmapScalingMode="HighQuality" Cursor="Hand" ToolTip="{Binding Media.OpenHint}"
                            RenderTransformOrigin="0.5,0.5"
                            MouseLeftButtonDown="Artwork_MouseDown" MouseLeftButtonUp="Artwork_MouseUp"
                            MouseLeave="Artwork_MouseLeave">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ArtworkScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Grid>
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                       Foreground="{StaticResource TertiaryText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border CornerRadius="14">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Media.Artwork}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <!-- Which app is playing: its real icon as a small badge on the art -->
                            <Image Source="{Binding Media.AppIcon}" Width="20" Height="20" Margin="0,0,-6,-6"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Media.Title}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryText}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Media.Artist}" FontSize="13" Margin="0,1,0,0"
                                   Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"/>
                        <!-- Where it is playing: "JioHotstar · Edge", "Spotify" -->
                        <TextBlock Text="{Binding Media.SourceLabel}" FontSize="11" Margin="0,1,0,0"
                                   Foreground="{StaticResource TertiaryText}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <controls:AudioBars x:Name="Bars" Grid.Column="2" Width="22" Height="18"
                                        VerticalAlignment="Top" Margin="0,6,0,0"
                                        BarBrush="{Binding Media.AccentBrush}"/>
                </Grid>

                <Grid Grid.Row="1" VerticalAlignment="Center"
                      Visibility="{Binding Media.HasTimeline, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Media.PositionText}" FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryText}" Typography.NumeralAlignment="Tabular"/>
                    <controls:SlimSlider x:Name="SeekSlider" Grid.Column="1" Height="18" Margin="4,0"
                                         VerticalAlignment="Center" ToolTip="Drag to seek"
                                         Value="{Binding Media.Progress, Mode=OneWay}"
                                         IsInteractive="{Binding Media.CanSeek, Mode=OneWay}"
                                         TrackBrush="{StaticResource TrackFill}" Fill="{StaticResource PrimaryText}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Media.RemainingText}" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryText}" Typography.NumeralAlignment="Tabular"/>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Width="44" Height="36" Click="Previous_Click"
                            IsEnabled="{Binding Media.CanSkipPrevious}">
                        <Path Data="{StaticResource PreviousGeometry}" Fill="White" Stretch="Uniform" Width="24" Height="15"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="48" Height="36" Margin="20,0" Click="PlayPause_Click">
                        <Path Fill="White" Stretch="Uniform" Width="20" Height="22">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource PlayGeometry}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Media.IsPlaying}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource PauseGeometry}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="44" Height="36" Click="Next_Click"
                            IsEnabled="{Binding Media.CanSkipNext}">
                        <Path Data="{StaticResource NextGeometry}" Fill="White" Stretch="Uniform" Width="24" Height="15"/>
                    </Button>
                </StackPanel>

                <!-- Volume (system master), mute, and shrink the music into a bubble -->
                <Grid Grid.Row="3" VerticalAlignment="Bottom" Height="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" Click="Mute_Click"
                            IsEnabled="{Binding Audio.HasDevice}">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE767;"/>
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Audio.IsMuted}" Value="True">
                                            <Setter Property="Text" Value="&#xE74F;"/>
                                            <Setter Property="Foreground" Value="#FFFF453A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <controls:SlimSlider x:Name="VolumeSlider" Grid.Column="1" Height="18" Margin="6,0"
                                         VerticalAlignment="Center"
                                         Value="{Binding Audio.Volume, Mode=OneWay}"
                                         IsInteractive="{Binding Audio.HasDevice, Mode=OneWay}"
                                         TrackBrush="{StaticResource TrackFill}" Fill="{StaticResource PrimaryText}">
                        <controls:SlimSlider.Style>
                            <Style TargetType="controls:SlimSlider">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Audio.IsMuted}" Value="True">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:SlimSlider.Style>
                    </controls:SlimSlider>
                    <Button x:Name="MinimizeButton" Grid.Column="3" Style="{StaticResource IconButton}" Width="28" Height="28"
                            Click="Minimize_Click" ToolTip="Shrink to a bubble">
                        <TextBlock x:Name="MinimizeGlyph" Text="&#xE73F;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{StaticResource SecondaryText}"/>
                    </Button>
                </Grid>
            </Grid>
            </Grid>

            <!-- Also playing: every other player, newest first; tap a row to swap it in -->
            <TextBlock Text="Also playing" Height="24" Padding="2,8,0,0" FontSize="10.5"
                       Foreground="{StaticResource TertiaryText}"
                       Visibility="{Binding Media.HasOtherSessions, Converter={StaticResource BoolToVis}}"/>
            <ItemsControl x:Name="AlsoPlayingList" ItemsSource="{Binding Media.OtherSessions}" Focusable="False" RenderTransformOrigin="0.5,0"
                          Visibility="{Binding Media.HasOtherSessions, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource RowButton}" Height="44" Margin="0,6,0,0" Click="Session_Click" ToolTip="Show this player">
                            <Grid Margin="8,0,7,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="30" Height="30" VerticalAlignment="Center">
                                    <Border CornerRadius="8" Background="{StaticResource ArtworkPlaceholder}"/>
                                    <Border CornerRadius="8" Visibility="{Binding ShowThumbnail, Converter={StaticResource BoolToVis}}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <Image Source="{Binding Icon}" Width="18" Height="18" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryText}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Margin="0,1,0,0"
                                               Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource CircleButton}" Width="30" Height="30"
                                        Click="OtherPlayPause_Click" ToolTip="Play or pause without switching">
                                    <Path Fill="White" Stretch="Uniform" Width="10" Height="11">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{StaticResource PlayGeometry}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource PauseGeometry}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.RenderTransform>
                    <TranslateTransform x:Name="AlsoPlayingSlide"/>
                </ItemsControl.RenderTransform>
            </ItemsControl>
            </StackPanel>
            <!-- Swap layer: pictures of the old player and the clicked row travel here while players switch -->
            <Canvas x:Name="SwapLayer" IsHitTestVisible="False"/>
            </Grid>

            <!-- ==================== Timer -->
            <Grid x:Name="TimerCard" Height="52">
                <!-- Nothing running: start the stopwatch or a quick timer from here -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding Timers.IsActive, Converter={StaticResource InvertedBoolToVis}}">
                    <Button Style="{StaticResource ChipButton}" Click="Stopwatch_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{StaticResource TimerOrange}" VerticalAlignment="Center" Margin="0,1,6,0"/>
                            <TextBlock Text="Stopwatch" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ChipButton}" Tag="1" Content="1 min" Click="Countdown_Click"/>
                    <Button Style="{StaticResource ChipButton}" Tag="5" Content="5 min" Click="Countdown_Click"/>
                    <Button Style="{StaticResource ChipButton}" Tag="25" Content="25 min" Click="Countdown_Click"/>
                </StackPanel>

                <!-- A stopwatch or timer is running (the island's own, or the Clock app's) -->
                <Grid Visibility="{Binding Timers.IsActive, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Width="38" Height="38" VerticalAlignment="Center">
                    <controls:ProgressRing Progress="{Binding Timers.Progress}" Thickness="3"
                                           Stroke="{StaticResource TimerOrange}" TrackBrush="{StaticResource TimerOrangeFill}"/>
                    <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{StaticResource TimerOrange}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Timers.Label}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TimerOrange}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Timers.StateText}" FontSize="11.5"
                               Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding Timers.DetailText}" Margin="0,0,12,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource TimerOrange}" Typography.NumeralAlignment="Tabular"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CircleButton}" Background="{StaticResource TimerOrangeFill}"
                            Click="TimerPause_Click">
                        <Path Fill="{StaticResource TimerOrange}" Stretch="Uniform" Width="12" Height="13">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource PlayGeometry}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Timers.IsRunning}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource PauseGeometry}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button Style="{StaticResource CircleButton}" Margin="8,0,0,0" Click="TimerStop_Click">
                        <Path Data="{StaticResource CloseGeometry}" Stroke="White" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="10" Height="10"/>
                    </Button>
                </StackPanel>
                </Grid>
            </Grid>

            <!-- ==================== One app's notifications (DataContext: the selected tab's group) -->
            <StackPanel x:Name="AppCard" Visibility="Collapsed" DataContext="{Binding Dashboard.Selected.Group}">
                <Grid Height="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding AppName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                             Foreground="{StaticResource PrimaryText}"/>
                        <Run Text="{Binding CountText, Mode=OneWay}" FontSize="12"
                             Foreground="{StaticResource TertiaryText}"/>
                    </TextBlock>
                    <Button Grid.Column="2" Style="{StaticResource TextButton}" Content="Open" Click="OpenApp_Click"/>
                    <Button Grid.Column="3" Style="{StaticResource TextButton}" Content="Clear" Click="ClearApp_Click"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding TopItems}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowButton}" Height="48" Margin="0,4,0,0" Click="OpenItem_Click"
                                    ToolTip="Open">
                                <Grid Margin="12,0,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryText}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Body}" FontSize="11.5" Margin="0,1,0,0"
                                                   Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding TimeText, Mode=OneWay}" FontSize="11" Margin="8,0,4,0"
                                               Foreground="{StaticResource TertiaryText}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28"
                                            Click="DismissItem_Click" ToolTip="Dismiss">
                                        <Path Data="{StaticResource CloseGeometry}" Stroke="{StaticResource SecondaryText}"
                                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Stretch="Uniform" Width="8" Height="8"/>
                                    </Button>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ==================== Notifications, One UI style: conversations first, then everything else -->
            <Grid x:Name="NotificationsCard" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Margin="2,0,0,0">
                        <Run Text="Notifications" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/>
                        <Run Text="  "/>
                        <Run Text="{Binding Dashboard.NotificationCountText, Mode=OneWay}" FontSize="11.5"
                             Foreground="{StaticResource TertiaryText}"/>
                    </TextBlock>
                    <Button Grid.Column="1" Style="{StaticResource TextButton}" Content="Clear all" Click="NotifClearAll_Click"
                            VerticalAlignment="Center"
                            Visibility="{Binding Dashboard.HasNotifications, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <ScrollViewer Grid.Row="1" Focusable="False" PanningMode="VerticalOnly"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding Dashboard.HasNotifications, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Conversations" Height="24" Padding="4,5,0,0" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryText}"
                                   Visibility="{Binding Dashboard.HasConversations, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Dashboard.Conversations}" Focusable="False"
                                      ItemTemplate="{StaticResource FeedGroup}"/>
                        <TextBlock Text="Notifications" Height="24" Padding="4,5,0,0" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryText}"
                                   Visibility="{Binding Dashboard.HasOtherNotifications, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Dashboard.OtherNotifications}" Focusable="False"
                                      ItemTemplate="{StaticResource FeedGroup}"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Dashboard.HasNotifications, Converter={StaticResource InvertedBoolToVis}}">
                    <TextBlock Text="&#xE7E7;" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Center"
                               Foreground="{StaticResource TertiaryText}"/>
                    <TextBlock Text="You're all caught up" FontSize="12.5" Margin="0,8,0,0" HorizontalAlignment="Center"
                               Foreground="{StaticResource SecondaryText}"/>
                </StackPanel>
            </Grid>

            <!-- ==================== History: what arrived lately, kept locally -->
            <Grid x:Name="HistoryCard" Height="236" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Recent notifications" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryText}"/>

                <ScrollViewer Grid.Row="1" Margin="0,6,0,0" Focusable="False" PanningMode="VerticalOnly"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Dashboard.History}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Icon}" Width="18" Height="18" Stretch="Uniform"
                                           VerticalAlignment="Top" Margin="0,1,0,0"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                        <TextBlock TextTrimming="CharacterEllipsis" FontSize="12">
                                            <Run Text="{Binding App, Mode=OneWay}" FontWeight="SemiBold"
                                                 Foreground="{StaticResource PrimaryText}"/>
                                            <Run Text="{Binding Title, Mode=OneWay}" Foreground="{StaticResource SecondaryText}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Body}" FontSize="11.5" Margin="0,1,0,0"
                                                   Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="11" VerticalAlignment="Top"
                                               Margin="0,1,0,0" Foreground="{StaticResource TertiaryText}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="1" Text="Nothing yet. Notifications you receive will collect here."
                           FontSize="12" Foreground="{StaticResource TertiaryText}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Dashboard.HasHistory}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </StackPanel>
</UserControl>
