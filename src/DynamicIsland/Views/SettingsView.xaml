<UserControl x:Class="DynamicIsland.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DynamicIsland.Views"
             xmlns:controls="clr-namespace:DynamicIsland.Controls"
             Width="760" Height="566">
    <!-- The island's Settings: a sidebar of categories, search on top, live controls on the right.
         DataContext is a SettingsModel. Every row reads real state through its SettingItem. -->
    <UserControl.Resources>
        <views:InvertedBoolToVisibility x:Key="InvertedBoolToVis"/>

        <!-- Thin dark scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="#38FFFFFF"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#880A84FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Hover" CornerRadius="9" Background="#12FFFFFF" Opacity="0"/>
                            <Border x:Name="Selected" CornerRadius="9" Background="#26FFFFFF" Opacity="0"/>
                            <ContentPresenter Margin="10,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource HoverIn}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource HoverOut}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource SelectIn}"/>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource SelectOut}"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource PressDownSoft}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource PressUp}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabButton" TargetType="Button" BasedOn="{StaticResource TabButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Hover" CornerRadius="11" Background="#14FFFFFF" Opacity="0"/>
                            <Border x:Name="Selected" CornerRadius="11" Background="#2EFFFFFF" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource HoverIn}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource HoverOut}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <DataTrigger Binding="{Binding Card}" Value="Settings">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource SelectIn}"/>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource SelectOut}"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource PressDown}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource PressUp}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="42" Height="24" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="12" Background="#38FFFFFF"/>
                            <Border x:Name="TrackOn" CornerRadius="12" Background="{StaticResource Accent}" Opacity="0"/>
                            <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="18" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border CornerRadius="9" Background="#12FFFFFF"/>
                            <Border x:Name="Selected" CornerRadius="9" Background="{StaticResource Accent}" Opacity="0"/>
                            <Border x:Name="Hover" CornerRadius="9" Background="#12FFFFFF" Opacity="0"/>
                            <ContentPresenter Margin="10,5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource HoverIn}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource HoverOut}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource SelectIn}"/>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource SelectOut}"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource PressDownSoft}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource PressUp}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title, optional note pill, description and "unavailable" reason: shared by every row -->
        <DataTemplate x:Key="RowLabel">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="26" Height="26" CornerRadius="7" Background="#26FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{StaticResource PrimaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource PrimaryText}"/>
                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="6" Background="#1FFFFFFF" VerticalAlignment="Center"
                            Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Note}" FontSize="10" Foreground="{StaticResource SecondaryText}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Description}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryText}"
                           Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding UnavailableReason}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource TimerOrange}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="RowShell" TargetType="Border">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="Background" Value="#260A84FF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="InfoRow">
            <Border Style="{StaticResource RowShell}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowLabel}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" MaxWidth="290" Margin="16,0,0,0"
                               TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryText}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ToggleRow">
            <Border Style="{StaticResource RowShell}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowLabel}"/>
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="16,0,0,0"
                              IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding IsAvailable}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SliderRow">
            <Border Style="{StaticResource RowShell}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowLabel}"/>
                    <controls:SlimSlider Grid.Column="1" Height="20" VerticalAlignment="Center" Margin="12,0,0,0"
                                         Value="{Binding Level, Mode=OneWay}" IsInteractive="{Binding IsAvailable}"
                                         TrackBrush="{StaticResource TrackFill}" Fill="{StaticResource PrimaryText}"
                                         Loaded="Slider_Loaded"/>
                    <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryText}" Typography.NumeralAlignment="Tabular"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ChoiceRow">
            <Border Style="{StaticResource RowShell}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowLabel}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Choices}" Margin="38,8,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SegmentButton}" Content="{Binding Text}" Click="Choice_Click" Margin="0,0,6,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ChoiceError}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TimerOrange}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChoiceError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LinkRow">
            <Border Style="{StaticResource RowShell}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowLabel}"/>
                    <Button Grid.Column="1" Style="{StaticResource TextButton}" Click="Link_Click" Margin="16,0,0,0"
                            VerticalAlignment="Center" ToolTip="Opens Windows Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Open" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       Margin="6,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ActionRow">
            <Border Style="{StaticResource RowShell}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowLabel}"/>
                    <Button Grid.Column="1" Style="{StaticResource ChipButton}" Content="{Binding ActionLabel}" Click="Action_Click"
                            Margin="16,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding IsAvailable}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Quick apps editor: the Home card's apps, plus a searchable picker of installed apps -->
        <Style x:Key="PickRowButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Hover" CornerRadius="8" Background="#1AFFFFFF" Opacity="0"/>
                            <ContentPresenter Margin="8,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource HoverIn}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource HoverOut}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource PressDownSoft}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource PressUp}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AppListRow">
            <Border Style="{StaticResource RowShell}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowLabel}"/>
                        <Button Grid.Column="1" Style="{StaticResource ChipButton}" Content="Add app" Click="AddApp_Click"
                                Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Payload.Apps}" Margin="38,10,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="78" Margin="0,0,6,6">
                                    <Button Style="{StaticResource TileButton}" Click="AppReplace_Click" ToolTip="Click to replace">
                                        <StackPanel Margin="0,8,0,4">
                                            <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource SubtleFill}">
                                                <Image Source="{Binding Icon}" Width="26" Height="26" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="11" Margin="0,4,0,0" MaxWidth="70"
                                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource SecondaryText}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource CircleButton}" Width="20" Height="20" Margin="2,0,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Click="AppMoveEarlier_Click" ToolTip="Move earlier">
                                        <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="8" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource CircleButton}" Width="20" Height="20" Margin="0,0,2,0"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="AppRemove_Click" ToolTip="Remove">
                                        <Path Data="{StaticResource CloseGeometry}" Stroke="White" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="7" Height="7"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding Payload.Message}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TimerOrange}"
                               Visibility="{Binding Payload.HasMessage, Converter={StaticResource BoolToVis}}"/>

                    <Border Margin="0,8,0,0" Padding="8" CornerRadius="10" Background="#14FFFFFF"
                            Visibility="{Binding Payload.IsPicking, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="4,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Payload.PickerTitle}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Style="{StaticResource TextButton}" Content="Cancel" Click="PickCancel_Click"/>
                            </Grid>
                            <Border CornerRadius="8" Background="#1AFFFFFF" Padding="10,0" Height="30">
                                <Grid>
                                    <TextBlock Text="Search apps" FontSize="13" Foreground="{StaticResource TertiaryText}"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="{Binding Payload.HasPickerQuery, Converter={StaticResource InvertedBoolToVis}}"/>
                                    <TextBox Tag="app-picker" Style="{StaticResource SearchBox}"
                                             Text="{Binding Payload.PickerQuery, UpdateSourceTrigger=PropertyChanged}"
                                             IsVisibleChanged="PickerSearch_IsVisibleChanged"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Payload.PickerStatus}" FontSize="12" Margin="4,8,0,2"
                                       Foreground="{StaticResource SecondaryText}"
                                       Visibility="{Binding Payload.HasPickerStatus, Converter={StaticResource BoolToVis}}"/>
                            <ListBox ItemsSource="{Binding Payload.PickerResults}" Height="210" Margin="0,6,0,0"
                                     Background="Transparent" BorderThickness="0" Focusable="False"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <ScrollViewer Focusable="False" CanContentScroll="True"
                                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource PickRowButton}" Click="AppPick_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" Margin="10,0,0,0"
                                                           Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <views:SettingRowSelector x:Key="RowSelector"
                                  Info="{StaticResource InfoRow}"
                                  Toggle="{StaticResource ToggleRow}"
                                  Slider="{StaticResource SliderRow}"
                                  Choice="{StaticResource ChoiceRow}"
                                  Link="{StaticResource LinkRow}"
                                  Action="{StaticResource ActionRow}"
                                  AppList="{StaticResource AppListRow}"/>
    </UserControl.Resources>

    <Grid Margin="18,12,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="36"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================== Dashboard tabs stay on top -->
        <ItemsControl x:Name="Switcher" HorizontalAlignment="Center" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource SettingsTabButton}" Click="Tab_Click" ToolTip="{Binding Label}">
                        <Grid Width="24" Height="24">
                            <!-- App icon style: coloured tile, soft gloss, white symbol -->
                            <Border CornerRadius="7" Background="{Binding Tint}"
                                    Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Border CornerRadius="7" Background="{StaticResource TabGloss}"/>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="12.5"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVis}}"/>
                            <Border CornerRadius="7" Visibility="{Binding ShowArt, Converter={StaticResource BoolToVis}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Border MinWidth="14" Height="14" CornerRadius="7" Padding="3,0" Background="#FFFF3B30"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-9,0"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding BadgeText}" FontSize="8.5" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Border>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ======================================================== Top bar -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
                <TextBlock Text="Settings" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusLine" FontSize="12" Margin="14,1,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TertiaryText}" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
            </StackPanel>
            <Border Grid.Column="2" Width="270" Height="32" CornerRadius="16" Background="#1AFFFFFF">
                <Grid Margin="12,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Search settings" FontSize="13" Margin="10,0,0,0" IsHitTestVisible="False"
                               Foreground="{StaticResource TertiaryText}" VerticalAlignment="Center"
                               Visibility="{Binding IsSearching, Converter={StaticResource InvertedBoolToVis}}"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource SearchBox}" Margin="8,0,0,0"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="22" Height="22" Click="ClearSearch_Click"
                            ToolTip="Clear" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
                        <Path Data="{StaticResource CloseGeometry}" Stroke="{StaticResource SecondaryText}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="7" Height="7"/>
                    </Button>
                </Grid>
            </Border>
            <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="32" Height="32" Margin="8,0,0,0"
                    Click="Close_Click" ToolTip="Close">
                <Path Data="{StaticResource CloseGeometry}" Stroke="{StaticResource PrimaryText}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="10" Height="10"/>
            </Button>
        </Grid>

        <!-- ======================================================== Sidebar and page -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="186"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource SidebarButton}" Click="Category_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="24" CornerRadius="7" Background="{Binding Tint}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="12.5"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" FontSize="13" Margin="10,0,0,0"
                                           Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="2,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,12,0" VerticalAlignment="Center"
                            Background="{Binding Current.Tint}"
                            Visibility="{Binding IsSearching, Converter={StaticResource InvertedBoolToVis}}">
                        <TextBlock Text="{Binding Current.Glyph}" FontFamily="{StaticResource IconFont}" FontSize="19"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/>
                        <TextBlock Text="{Binding PageDescription}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" PanningMode="VerticalOnly">
                    <StackPanel Margin="0,0,10,0">
                        <!-- Overview: big status tiles -->
                        <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False" Margin="0,0,-8,0"
                                      Visibility="{Binding HasTiles, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,8,14" CornerRadius="14" Background="#17FFFFFF" Padding="12,11" ToolTip="{Binding Value}">
                                        <StackPanel>
                                            <Border Width="26" Height="26" CornerRadius="7" Background="#26FFFFFF" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                           Foreground="{StaticResource PrimaryText}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="11.5" Margin="0,10,0,0"
                                                       Foreground="{StaticResource SecondaryText}"/>
                                            <TextBlock Text="{Binding Value}" FontSize="15" FontWeight="SemiBold" Margin="0,1,0,0"
                                                       Foreground="{StaticResource PrimaryText}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl x:Name="PageSections" ItemsSource="{Binding VisibleSections}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <Button Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="2,0,0,5"
                                                Click="Section_Click" IsHitTestVisible="{Binding IsSearchResult}">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource SecondaryText}"/>
                                        </Button>
                                        <Border CornerRadius="14" Background="#17FFFFFF" Padding="0,4">
                                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False"
                                                          ItemTemplateSelector="{StaticResource RowSelector}"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
