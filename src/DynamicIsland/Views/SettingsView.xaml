<UserControl x:Class="DynamicIsland.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DynamicIsland.Views"
             xmlns:controls="clr-namespace:DynamicIsland.Controls"
             Width="760" Height="520">
    <!-- The island's Settings: a sidebar of categories, search on top, live controls on the right.
         DataContext is a SettingsModel. Every row reads real state through its SettingItem. -->
    <UserControl.Resources>
        <views:InvertedBoolToVisibility x:Key="InvertedBoolToVis"/>

        <!-- Thin dark scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="#38FFFFFF"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#880A84FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="9" Background="Transparent" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#26FFFFFF"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="42" Height="24" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="12" Background="#38FFFFFF"/>
                            <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF30D158"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="18" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="9" Background="#12FFFFFF" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F2FFFFFF"/>
                                <Setter Property="Foreground" Value="#FF000000"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title, optional note pill, description and "unavailable" reason: shared by every row -->
        <DataTemplate x:Key="RowLabel">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource PrimaryText}"/>
                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="6" Background="#1FFFFFFF" VerticalAlignment="Center"
                            Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Note}" FontSize="10" Foreground="{StaticResource SecondaryText}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Description}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryText}"
                           Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding UnavailableReason}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource TimerOrange}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="RowShell" TargetType="Border">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="Background" Value="#260A84FF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="InfoRow">
            <Border Style="{StaticResource RowShell}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowLabel}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" MaxWidth="290" Margin="16,0,0,0"
                               TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryText}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ToggleRow">
            <Border Style="{StaticResource RowShell}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowLabel}"/>
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="16,0,0,0"
                              IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding IsAvailable}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SliderRow">
            <Border Style="{StaticResource RowShell}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowLabel}"/>
                    <controls:SlimSlider Grid.Column="1" Height="20" VerticalAlignment="Center" Margin="12,0,0,0"
                                         Value="{Binding Level, Mode=OneWay}" IsInteractive="{Binding IsAvailable}"
                                         TrackBrush="{StaticResource TrackFill}" Fill="{StaticResource PrimaryText}"
                                         Loaded="Slider_Loaded"/>
                    <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryText}" Typography.NumeralAlignment="Tabular"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ChoiceRow">
            <Border Style="{StaticResource RowShell}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowLabel}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Choices}" Margin="0,8,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SegmentButton}" Content="{Binding Text}" Click="Choice_Click" Margin="0,0,6,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ChoiceError}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TimerOrange}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChoiceError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LinkRow">
            <Border Style="{StaticResource RowShell}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowLabel}"/>
                    <Button Grid.Column="1" Style="{StaticResource TextButton}" Click="Link_Click" Margin="16,0,0,0"
                            VerticalAlignment="Center" ToolTip="Opens Windows Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Open" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       Margin="6,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ActionRow">
            <Border Style="{StaticResource RowShell}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowLabel}"/>
                    <Button Grid.Column="1" Style="{StaticResource ChipButton}" Content="{Binding ActionLabel}" Click="Action_Click"
                            Margin="16,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding IsAvailable}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <views:SettingRowSelector x:Key="RowSelector"
                                  Info="{StaticResource InfoRow}"
                                  Toggle="{StaticResource ToggleRow}"
                                  Slider="{StaticResource SliderRow}"
                                  Choice="{StaticResource ChoiceRow}"
                                  Link="{StaticResource LinkRow}"
                                  Action="{StaticResource ActionRow}"/>
    </UserControl.Resources>

    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================== Top bar -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Width="32" Height="32" Click="Back_Click" ToolTip="Back (Esc)">
                <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource PrimaryText}"/>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock Text="Settings" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusLine" FontSize="12" Margin="14,1,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TertiaryText}" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
            </StackPanel>
            <Border Grid.Column="2" Width="270" Height="32" CornerRadius="16" Background="#1AFFFFFF">
                <Grid Margin="12,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Search settings" FontSize="13" Margin="10,0,0,0" IsHitTestVisible="False"
                               Foreground="{StaticResource TertiaryText}" VerticalAlignment="Center"
                               Visibility="{Binding IsSearching, Converter={StaticResource InvertedBoolToVis}}"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource SearchBox}" Margin="8,0,0,0"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="22" Height="22" Click="ClearSearch_Click"
                            ToolTip="Clear" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
                        <Path Data="{StaticResource CloseGeometry}" Stroke="{StaticResource SecondaryText}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="7" Height="7"/>
                    </Button>
                </Grid>
            </Border>
            <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="32" Height="32" Margin="8,0,0,0"
                    Click="Close_Click" ToolTip="Close">
                <Path Data="{StaticResource CloseGeometry}" Stroke="{StaticResource PrimaryText}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="10" Height="10"/>
            </Button>
        </Grid>

        <!-- ======================================================== Sidebar and page -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="186"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource SidebarButton}" Click="Category_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" Width="18"
                                           Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" FontSize="13" Margin="10,0,0,0"
                                           Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="4,0,0,12">
                    <TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/>
                    <TextBlock Text="{Binding PageDescription}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryText}"/>
                </StackPanel>

                <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" PanningMode="VerticalOnly">
                    <ItemsControl x:Name="PageSections" ItemsSource="{Binding VisibleSections}" Focusable="False" Margin="0,0,10,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <Button Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="-2,0,0,4"
                                            Click="Section_Click" IsHitTestVisible="{Binding IsSearchResult}">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"/>
                                    </Button>
                                    <Border CornerRadius="14" Background="#10FFFFFF" Padding="0,4">
                                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False"
                                                      ItemTemplateSelector="{StaticResource RowSelector}"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
