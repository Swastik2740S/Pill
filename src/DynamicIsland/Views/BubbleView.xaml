<UserControl x:Class="DynamicIsland.Views.BubbleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="30" Height="30" Cursor="Hand" Focusable="False">
    <!-- A detached mini bubble: one waiting app (icon and unread badge), or music (album art). -->
    <Grid>
        <Ellipse x:Name="Fill" Fill="{StaticResource GlassFill}"/>
        <Ellipse x:Name="Sheen" Fill="{StaticResource GlassSheen}" IsHitTestVisible="False"/>

        <Image x:Name="Icon" Width="18" Height="18" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
        <TextBlock x:Name="Glyph" Text="&#xE7E7;" FontFamily="{StaticResource IconFont}" FontSize="13"
                   Foreground="{StaticResource PrimaryText}" Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

        <!-- Music: the album art fills the bubble; paused music dims it under a play mark -->
        <Ellipse x:Name="Art" Margin="2.5" Visibility="Collapsed" IsHitTestVisible="False"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
        <Ellipse x:Name="PausedDim" Margin="2.5" Fill="#66000000" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Path x:Name="PausedMark" Data="{StaticResource PlayGeometry}" Fill="White" Stretch="Uniform"
              Width="9" Height="10" Margin="1.5,0,0,0" Visibility="Collapsed" IsHitTestVisible="False"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Ellipse x:Name="Rim" Stroke="{StaticResource GlassRim}" StrokeThickness="1" IsHitTestVisible="False"/>

        <Border x:Name="Badge" MinWidth="15" Height="15" CornerRadius="7.5" Padding="4,0"
                Background="#FFFF3B30" BorderBrush="#FF000000" BorderThickness="1.5"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-6,0" IsHitTestVisible="False">
            <TextBlock x:Name="BadgeText" FontSize="9" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
        </Border>
    </Grid>
</UserControl>
