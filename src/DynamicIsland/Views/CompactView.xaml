<UserControl x:Class="DynamicIsland.Views.CompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DynamicIsland.Controls"
             Width="290" Height="34">
    <!-- Live activity pill: [artwork | timer ring]  [title | label]  [waveform | time] -->
    <Grid Margin="6,0,12,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Leading slot -->
        <Grid Grid.Column="0" Width="23" Height="23" VerticalAlignment="Center">
            <Border x:Name="ArtworkSlot" CornerRadius="6" Background="{StaticResource ArtworkPlaceholder}"
                    RenderOptions.BitmapScalingMode="HighQuality">
                <Grid>
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="{StaticResource TertiaryText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border CornerRadius="6">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Media.Artwork}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <Image Source="{Binding Media.AppIcon}" Width="11" Height="11" Margin="0,0,-3,-3"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>
            <controls:ProgressRing x:Name="TimerSlot" Width="20" Height="20" Visibility="Collapsed"
                                   Progress="{Binding Timers.Progress}" Thickness="2.4"
                                   Stroke="{StaticResource TimerOrange}" TrackBrush="{StaticResource TimerOrangeFill}"/>
        </Grid>

        <!-- Center label -->
        <TextBlock x:Name="MediaTitle" Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                   FontSize="12" Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"
                   Text="{Binding Media.Title}"/>
        <TextBlock x:Name="TimerLabel" Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Visibility="Collapsed"
                   FontSize="12" Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"
                   Text="{Binding Timers.Label}"/>

        <!-- Trailing slot -->
        <controls:AudioBars x:Name="Bars" Grid.Column="2" Width="22" Height="16" VerticalAlignment="Center"
                            BarBrush="{Binding Media.AccentBrush}"/>
        <TextBlock x:Name="TimerText" Grid.Column="2" VerticalAlignment="Center" Visibility="Collapsed"
                   FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource TimerOrange}" Typography.NumeralAlignment="Tabular"
                   Text="{Binding Timers.CompactText}"/>
    </Grid>
</UserControl>
