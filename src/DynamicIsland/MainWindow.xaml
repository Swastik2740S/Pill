<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DynamicIsland.Views"
        Title="Dynamic Island"
        Width="800" Height="470"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Focusable="False" UseLayoutRounding="False" SnapsToDevicePixels="False"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">

    <!--
        The window never resizes. Only the island inside it morphs, which avoids the
        expensive per-frame HWND resize that makes most Windows overlays stutter. Fully
        transparent pixels are click-through, so the unused window area never blocks clicks.
    -->
    <Grid x:Name="Root">
        <!-- Mini bubbles live below the island in z-order, so new ones emerge from behind the pill. -->
        <Canvas x:Name="BubbleLayer"/>

        <Grid x:Name="Island"
              HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
              Width="124" Height="30" RenderTransformOrigin="0.5,0"
              MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
              MouseLeftButtonDown="Island_MouseLeftButtonDown" MouseLeftButtonUp="Island_MouseLeftButtonUp">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="IslandScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="IslandShift" Y="0"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <Grid.ContextMenu>
                <ContextMenu Opened="Menu_Opened" Closed="Menu_Closed">
                    <MenuItem x:Name="OpenIslandItem" Header="Open island" Click="OpenIsland_Click"/>
                    <MenuItem Header="Settings" Click="OpenSettings_Click"/>
                    <Separator/>
                    <MenuItem Header="Start stopwatch" Click="Stopwatch_Click"/>
                    <MenuItem Header="Start timer">
                        <MenuItem Header="1 minute" Tag="1" Click="Timer_Click"/>
                        <MenuItem Header="5 minutes" Tag="5" Click="Timer_Click"/>
                        <MenuItem Header="10 minutes" Tag="10" Click="Timer_Click"/>
                        <MenuItem Header="25 minutes" Tag="25" Click="Timer_Click"/>
                        <MenuItem Header="1 hour" Tag="60" Click="Timer_Click"/>
                    </MenuItem>
                    <MenuItem x:Name="StopTimerItem" Header="Stop timer" Click="StopTimer_Click"/>
                    <MenuItem x:Name="ClearNotificationsItem" Header="Clear notifications" Click="ClearNotifications_Click"/>
                    <Separator/>
                    <MenuItem Header="Style">
                        <MenuItem x:Name="GlassStyleItem" Header="Glass" Click="GlassStyle_Click"/>
                        <MenuItem x:Name="SolidStyleItem" Header="Solid black" Click="SolidStyle_Click"/>
                    </MenuItem>
                    <MenuItem x:Name="AutoStartItem" Header="Start with Windows" IsCheckable="True" Click="AutoStart_Click"/>
                    <Separator/>
                    <MenuItem Header="Quit Dynamic Island" Click="Quit_Click"/>
                </ContextMenu>
            </Grid.ContextMenu>

            <!-- Surface layers. Glass: tint over the live acrylic blur, plus sheen and rim light.
                 Solid: plain black, sheen and rim hidden. -->
            <Border x:Name="IslandFill" CornerRadius="15" Background="{StaticResource GlassFill}"/>
            <Border x:Name="IslandSheen" CornerRadius="15" Background="{StaticResource GlassSheen}" IsHitTestVisible="False"/>
            <!-- Tucked bar: a soft light that fills while the pointer rests on it, just before it opens. -->
            <Border x:Name="IslandProgress" CornerRadius="15" Background="White" Opacity="0" IsHitTestVisible="False"/>

            <!-- Content views have fixed sizes and stay centred; the island's rounded clip reveals them. -->
            <Grid x:Name="ContentHost">
                <views:CompactView x:Name="CompactPane" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <views:ExpandedView x:Name="ExpandedPane" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <views:ToastView x:Name="ToastPane" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <views:PeekView x:Name="PeekPane" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <views:SettingsView x:Name="SettingsPane" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <views:TuckedView x:Name="TuckedPane" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            </Grid>

            <!-- Privacy dots: green while an app uses the camera, orange while one records from the
                 microphone. They live inside the island at its right end (top-right corner when it is
                 open); the pill widens a little so they never sit on top of its content.
                 Placed and sized in ApplyGeometry. -->
            <StackPanel x:Name="PrivacyDots" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" Background="Transparent"
                        DataContext="{Binding Privacy}" ToolTip="{Binding Tooltip}">
                <StackPanel.RenderTransform>
                    <ScaleTransform x:Name="PrivacyScale" ScaleX="0.3" ScaleY="0.3"/>
                </StackPanel.RenderTransform>
                <Ellipse x:Name="CameraDot" Width="6" Height="6" Fill="#FF30D158" VerticalAlignment="Center"
                         Visibility="{Binding CameraInUse, Converter={StaticResource BoolToVis}}">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#FF30D158" BlurRadius="6" ShadowDepth="0" Opacity="0.75"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse x:Name="MicDot" Width="6" Height="6" Fill="#FFFF9F0A" VerticalAlignment="Center"
                         Visibility="{Binding MicInUse, Converter={StaticResource BoolToVis}}">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#FFFF9F0A" BlurRadius="6" ShadowDepth="0" Opacity="0.75"/>
                    </Ellipse.Effect>
                </Ellipse>
            </StackPanel>

            <Border x:Name="IslandRim" CornerRadius="15" BorderThickness="1" BorderBrush="{StaticResource GlassRim}" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Window>
